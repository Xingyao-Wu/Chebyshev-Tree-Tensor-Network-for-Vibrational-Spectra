!B3LYP def2-TZVPD ExtremeSCF VPT2

%vpt2
    VPT2                On      # do a VPT2 analysis, same as !VPT2 (see above)
    AnharmDisp          0.05    # anharmonic displacement factor, default is 0.05
    HessianCutoff       1e-12
    PrintLevel          1       # VPT2 print level [1, 2, 3, 4]
end

%method
    Z_Tol               1e-14
end

*xyz 0 1
  O          -0.00000000000000      0.00000000000000      0.12000000000000
  H           0.00000000000000      0.76500528325267     -0.46578561496644
  H           0.00000000000000     -0.76500528170583     -0.46578561378288
*